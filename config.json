{
  "camera": {
    "index": 0,
    "width": 640,
    "height": 480,
    "backend": "dshow"
  },
  "hand": {
    "model_path": "models/hand_landmarker.task",
    "num_hands": 1,
    "min_hand_detection_confidence": 0.65,
    "min_hand_presence_confidence": 0.6,
    "min_tracking_confidence": 0.5,
    "track_width": 256,
    "track_height": 192
  },
  "tracking": {
    "frame_margin": 0.02,
    "min_hand_score": 0.6,
    "min_palm_size": 0.01,
    "max_palm_size": 0.5,
    "motion_blur_speed": 2.5
  },
  "stabilizer": {
    "window_frames": 7,
    "required_frames": 5,
    "stable_ms": 120
  },
  "pinch": {
    "threshold": 0.4,
    "drag_hold_ms": 400,
    "click_cooldown_ms": 350,
    "confirm_frames": 2
  },
  "cursor": {
    "smoothing_alpha": 0.12,
    "dead_zone": 5.0,
    "overscan": 1.5,
    "overscan_y": 2.5,
    "drag_sensitivity": 1.4,
    "pinch_guard_ratio": 0.65,
    "pinch_release_ms": 180
  },
  "scroll": {
    "enabled": true,
    "wheel_step": 300,
    "cooldown_ms": 120
  },
  "volume": {
    "enabled": true,
    "step": 0.04,
    "cooldown_ms": 300
  },
  "mappings": {
    "cursor": "POINT",
    "pinch": "PINCH",
    "scroll_up": "TWO_UP",
    "scroll_down": "TWO_DOWN",
    "volume_up": "THUMBS_UP",
    "volume_down": "THUMBS_DOWN"
  },
  "hotkeys": {
    "toggle": "space",
    "quit": "esc"
  }
}
